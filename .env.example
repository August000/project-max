# --- OpenAI (LLM + Whisper STT + Vision + mem0 embeddings) ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Gemini TTS (https://ai.google.dev/) ---
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Voice options: Zephyr, Puck, Charon, Kore, Fenrir, Aoede, etc.
GEMINI_TTS_VOICE=Zephyr

# --- Qdrant (local) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ai_companion

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Shared secret the ESP32 must send in the WS query string (?key=...)
DEVICE_SHARED_SECRET=change-me-please

# --- Voice activity detection (silero) ---
# Lower threshold = more sensitive. 0.4-0.6 is typical.
VAD_THRESHOLD=0.5
# Silence (ms) needed before "end of utterance" fires.
VAD_MIN_SILENCE_MS=500
